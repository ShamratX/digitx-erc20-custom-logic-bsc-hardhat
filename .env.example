# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Deployer wallet (no 0x prefix required by most tools, but 0x is fine)
PRIVATE_KEY=your_private_key_here

# RPC URLs
ETH_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
ETH_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# DigitX constructor reserve wallets (must be non-zero addresses)
LP_WALLET=0x0000000000000000000000000000000000000001
EXCHANGE_WALLET=0x0000000000000000000000000000000000000002
TREASURY_WALLET=0x0000000000000000000000000000000000000003
MARKETING_WALLET=0x0000000000000000000000000000000000000004
TEAM_WALLET=0x0000000000000000000000000000000000000005
DEV_WALLET=0x0000000000000000000000000000000000000006
